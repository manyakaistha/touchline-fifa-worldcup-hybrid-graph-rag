# Relative paths resolve from the repository root. The graph is always opened read-only.
GRAPH_PATH=fifa_production_graphrag_db(2)
SEMANTIC_PATH=data/semantic
HOST=127.0.0.1
PORT=8000
# Optional hosted answer generation. Never commit your actual .env.
GROQ_API_KEY=
# The alias groq_api is also accepted.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
ENABLE_PAID_INFERENCE=true
# Set false to forbid inference, even when the UI requests generation.
# Retrieval requests default to generate=false; startup never calls Groq.
REQUEST_TIMEOUT=45
GRAPH_TIMEOUT_MS=5000
